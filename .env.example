# Discord Bot Token (wajib dari Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Bot Owner User ID (opsional untuk bypass admin check)
OWNER_ID=

# AI Model & Gateway URL (9Router / OpenAI Compatible Endpoint)
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=sk-xxxx
AI_MODEL=ag/gemini-3.8-flash

# Port for cloud healthcheck server (opsional jika jalan di PaaS)
# PORT=3000
